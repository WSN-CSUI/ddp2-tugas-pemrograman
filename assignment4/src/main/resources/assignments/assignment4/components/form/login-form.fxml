<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<GridPane xmlns:fx="http://javafx.com/fxml"
          xmlns="http://javafx.com/javafx"
          fx:controller="assignments.assignment4.components.form.LoginFormController"
          alignment="CENTER">
    <Label
            GridPane.rowIndex="0"
            GridPane.columnIndex="0"
            GridPane.columnSpan="2">
        Welcome to DepeFood
    </Label>
    <Label
            GridPane.rowIndex="1"
            GridPane.columnIndex="0">
        Name:
    </Label>
    <TextField
            fx:id="username"
            GridPane.rowIndex="1"
            GridPane.columnIndex="1"/>
    <Label
            GridPane.rowIndex="2"
            GridPane.columnIndex="0">
        Phone Number:
    </Label>
    <TextField
            fx:id="phone"
            GridPane.rowIndex="2"
            GridPane.columnIndex="1"/>
    <Button
            GridPane.rowIndex="3"
            GridPane.columnIndex="1"
            onAction="#handleLogin">
        Login
    </Button>
</GridPane>
