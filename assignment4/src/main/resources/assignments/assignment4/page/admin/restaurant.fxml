<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="assignments.assignment4.page.admin.RestaurantController"
      alignment="CENTER">
    <VBox alignment="CENTER">
        <Label>Restaurant Name:</Label>
        <TextField fx:id="restaurantName"/>
        <Button onAction="#handleViewRestaurant">Search</Button>
    </VBox>
    <VBox alignment="CENTER">
        <Label>Menu</Label>
        <ListView fx:id="menuItems"/>
    </VBox>
    <Button onAction="#redirectToBaseMenu">Kembali</Button>
</VBox>
